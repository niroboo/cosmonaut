{
  "name": "@niroboo/cosmonaut",
  "version": "0.3.5",
  "description": "A CosmosDB query builder library for Node",
  "author": "",
  "license": "MIT",
  "repository": "github:niroboo/cosmonaut",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.cts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=16"
  },
  "sideEffects": false,
  "scripts": {
    "test": "jest",
    "lint": "eslint src",
    "fix": "eslint src --fix",
    "build": "tsup"
  },
  "peerDependencies": {
    "@azure/cosmos": ">=3.16",
    "typescript": ">=4.8"
  },
  "peerDependenciesMeta": {
    "@azure/cosmos": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^29.4.0",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0",
    "eslint": "^8.35.0",
    "jest": "^29.4.3",
    "ts-jest": "^29.0.5",
    "tsup": "^8.5.0",
    "typescript": "^4.9.5"
  }
}
